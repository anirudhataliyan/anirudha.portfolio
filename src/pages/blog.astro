---
import feedStyles from "@/assets/styles/modules/feed.module.scss";
import BaseLayout from "@/islands/base-layout.astro";
import Layout from "@/islands/layout.astro";
import Page from "@/islands/page.astro";

import medium from "@/content/medium.json";
import { getSiteMetadata } from "@/utils/get-site-metadata";

const { title } = getSiteMetadata();
const items = medium.items as { title: string; link: string; date: string; description: string }[];
const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("en-US", { year: "numeric", month: "long" });
---

<BaseLayout title={`Blog - ${title}`} description="Articles from my Medium blog.">
  <Layout>
    <Page id="blog" heading="Blog" title="Blog">
      <section class={feedStyles.feed} aria-label="Medium articles">
        {
          items.length === 0 ? (
            <p>
              Articles from <a href="https://medium.com/@anirudhataliyan">Medium</a> will show up here after the first sync.
            </p>
          ) : (
            items.map((item) => (
              <article class={feedStyles.item}>
                <header>
                  <time class={feedStyles.time} datetime={item.date}>{formatDate(item.date)}</time>
                  <h3 class={feedStyles.title}>
                    <a class={feedStyles.link} href={item.link} rel="noopener">{item.title}</a>
                  </h3>
                </header>
                <p class={feedStyles.description}>{item.description}</p>
                <footer>
                  <a class={feedStyles.more} href={item.link} rel="noopener">Read on Medium</a>
                </footer>
              </article>
            ))
          )
        }
      </section>
    </Page>
  </Layout>
</BaseLayout>
